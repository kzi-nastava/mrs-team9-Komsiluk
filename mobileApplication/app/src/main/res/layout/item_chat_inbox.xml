<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ivInboxAvatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/profile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvInboxName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Marko Markovic"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/ivInboxAvatar"
        app:layout_constraintTop_toTopOf="@id/ivInboxAvatar"
        app:layout_constraintEnd_toStartOf="@id/tvInboxTime"/>

    <TextView
        android:id="@+id/tvInboxLastMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Hvala, stigao sam..."
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/tvInboxName"
        app:layout_constraintTop_toBottomOf="@id/tvInboxName"
        app:layout_constraintEnd_toStartOf="@id/tvUnreadCount" />

    <TextView
        android:id="@+id/tvInboxTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="14:30"
        android:textSize="12sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvInboxName" />

    <TextView
        android:id="@+id/tvUnreadCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_unread_badge"
        tools:text="3"
        android:textColor="@color/secondary"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:minWidth="20dp"
        android:minHeight="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/ivInboxAvatar" />

    <android.view.View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/black"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/ivInboxAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>